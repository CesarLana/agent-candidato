# Configurações do Agente de Candidaturas

# Chave de API de IA (Opcional se usar o modo heurístico, mas recomendado para respostas personalizadas)
# Suporta Google Gemini ou OpenAI
GEMINI_API_KEY=
OPENAI_API_KEY=

# Modelo preferido (gemini-2.0-flash, gemini-1.5-flash, gpt-4o-mini)
LLM_MODEL=gemini-2.0-flash

# Notificações e Aprovação Remota pelo Celular (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Rastreador de Feedback e Convites de Entrevista por E-mail (IMAP)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASSWORD=

# Caminho do perfil do candidato (padrão: config/profile.yaml)
CANDIDATE_PROFILE_PATH=config/profile.yaml

# Modo do Navegador:
# HEADLESS=false (recomendado: abre a janela para você ver e validar)
# HEADLESS=true (segundo plano)
BROWSER_HEADLESS=false

# Velocidade de digitação simulada em milissegundos por caractere
TYPING_DELAY_MS=25
